{
  "expo": {
    "name": "Paymerch Mobile",
    "slug": "paymerch-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/paymerch-icon.png",
    "splash": {
      "image": "./assets/images/paymerch-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBFBFA"
    },
    "scheme": "paymerch-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/paymerch-icon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Paymerch Mobile to use Face ID to unlock your wallet."
        }
      ]
    ]
  }
}
